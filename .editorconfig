root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.{js,json,vue,html,css,yml,yaml}]
indent_size = 2

[*.cs]
indent_size = 4

# Convenciones de nomenclatura .NET. El código base viola PascalCase en
# Afiliado.createdAt e isActive; estas reglas lo vuelven un warning visible
# en lugar de un detalle que se arrastra.
dotnet_naming_rule.propiedades_publicas_en_pascal_case.severity = warning
dotnet_naming_rule.propiedades_publicas_en_pascal_case.symbols = miembros_publicos
dotnet_naming_rule.propiedades_publicas_en_pascal_case.style = pascal_case

dotnet_naming_symbols.miembros_publicos.applicable_kinds = property, method, field, event
dotnet_naming_symbols.miembros_publicos.applicable_accessibilities = public

dotnet_naming_style.pascal_case.capitalization = pascal_case

csharp_style_namespace_declarations = file_scoped:suggestion
dotnet_diagnostic.CS8618.severity = warning

[*.{csproj,sln,props,targets}]
indent_size = 2

[*.sln]
end_of_line = crlf
